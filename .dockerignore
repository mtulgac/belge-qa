# Build context slimming, these are provided at runtime (volumes) or never needed.
.venv/
out/
**/__pycache__/
*.pyc
.git/
.pytest_cache/
# data/ (samples + golden set) IS baked in so the image is self-contained.
# User state (web UI uploads + their index) comes from named volumes, never the image.
data/uploads/
data/index/runtime/
personal/
